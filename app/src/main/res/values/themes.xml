<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Alpenlan" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/alpenlan_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Alpenlan Light: schwarzes Vollbild ohne Leisten -->
    <style name="Theme.Alpenlan.Show" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Alpenlan Browser: Filter-Browser mit Adressleiste -->
    <style name="Theme.Alpenlan.Browser" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#070b12</item>
        <item name="android:colorPrimaryDark">#070b12</item>
        <item name="android:colorAccent">#4da3ff</item>
        <item name="android:colorControlActivated">#4da3ff</item>
        <item name="android:textColorPrimary">#eef2f7</item>
        <item name="android:textColorSecondary">#8a96a8</item>
        <item name="android:windowBackground">@color/alpenlan_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:popupMenuStyle">@style/Alpenlan.Browser.Popup</item>
    </style>

    <style name="Alpenlan.Browser.Popup" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/browser_popup_bg</item>
    </style>
</resources>
